{
  "manifest_version": 3,
  "name": "FocusLock Blocker",
  "version": "1.2.0",
  "description": "Blocks distracting sites during your FocusLock focus sessions, with no permission prompts.",
  "permissions": ["declarativeNetRequest", "alarms", "webNavigation", "tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusLock"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "pace.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
