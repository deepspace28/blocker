{
  "name": "focuslock",
  "productName": "FocusLock",
  "version": "1.0.0",
  "description": "A personal distraction blocker, like Freedom: block sites, schedule sessions, hard mode, and track your stats.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "sudo-prompt": "^9.2.1"
  },
  "build": {
    "appId": "com.focuslock.app",
    "productName": "FocusLock",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "mac": { "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
