{
  "name": "focuslock",
  "productName": "FocusLock",
  "version": "1.0.0",
  "description": "A personal distraction blocker, like Freedom: block sites, schedule sessions, hard mode, and track your stats.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "Jishnav",
  "license": "MIT",
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "build": {
    "appId": "com.focuslock.app",
    "productName": "FocusLock",
    "files": [
      "src/**/*",
      "assets/**/*",
      "extension/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FocusLock",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage"
    },
    "extraResources": [
      {
        "from": "extension",
        "to": "extension"
      }
    ]
  }
}